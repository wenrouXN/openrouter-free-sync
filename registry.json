{
  "plugins": [
    {
      "id": "openrouter-free-sync",
      "name": "OpenRouter Free Model Sync",
      "description": "Auto-sync free OpenRouter models (configurable filters: context length, pricing, provider exclusion) into CPA's openai-compatibility provider. Web panel for config & manual refresh. Background timer for periodic sync.",
      "latest_version": "0.1.0",
      "author": "guofukun",
      "github_repository": "https://github.com/guofukun/openrouter-free-sync",
      "capabilities": ["management_api"],
      "config_fields": [
        {"name": "refresh_interval", "type": "string", "description": "Auto-sync interval (e.g. 24h, 6h, 1h, 30m)"},
        {"name": "min_context_length", "type": "integer", "description": "Minimum context length filter"},
        {"name": "pricing_filter", "type": "enum", "values": ["free", "any"], "description": "free=$0/$0, any=include all"},
        {"name": "excluded_providers", "type": "string", "description": "Comma-separated provider prefixes to exclude"},
        {"name": "require_text_output", "type": "boolean", "description": "Exclude non-text-output models"},
        {"name": "require_tools_support", "type": "boolean", "description": "Exclude models without function-calling"},
        {"name": "openrouter_api_key", "type": "string", "description": "OpenRouter API key"},
        {"name": "openrouter_base_url", "type": "string", "description": "OpenRouter API base URL"},
        {"name": "provider_name", "type": "string", "description": "CPA openai-compatibility provider name"},
        {"name": "management_key", "type": "string", "description": "CPA management API key (empty=use env)"},
        {"name": "cpa_base_url", "type": "string", "description": "CPA base URL"}
      ]
    }
  ]
}
